<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TUHH-Cloud"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cloudState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mit TUHH-Cloud verbinden" />

        <Button
            android:id="@+id/logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Abmelden" />

        <Button
            android:id="@+id/back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="← Zurück zur Kamera" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="So funktioniert es:\n\n• Fotos werden nur in dieser App gespeichert, nicht in der Galerie / Google Fotos.\n• Nach jedem Foto wird es sofort in den Cloud-Ordner „DrawboardCam“ hochgeladen.\n• Ohne Internet bleibt das Foto einfach hier in der App (unter dem kleinen Vorschaubild unten links).\n• Auslösen geht auch mit den Lautstärketasten.\n\nBeim Verbinden öffnet sich der normale TUHH-Login im Browser. Danach wieder zur App zurückkehren."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
